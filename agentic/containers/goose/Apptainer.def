Bootstrap: localimage
From: ../mcp/mcp.sif
Stage: build

# ---------------------------------------------------------------------------
# chat-ai Goose agent image (Task 4.1, 001-agentic-layer).
#
# Bootstraps from ../mcp/mcp.sif. Installs AAIF Goose CLI + goose_runtime/
# launcher (MCP uvicorn → /health → Goose run + broker SSE ingest).
#
# Run:
#     python3.11 -m goose_runtime.launcher
#
# Smoke / tests can set GOOSE_DEV_COMMAND_OVERRIDE=/bin/true to bypass Goose.
# ---------------------------------------------------------------------------

%files
    ../../goose_runtime /opt/agentic/goose_runtime
    ../../openhands_runtime /opt/agentic/openhands_runtime
    entrypoint.sh /opt/agentic/entrypoint.sh

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    export PATH=/usr/local/bin:/usr/bin:/bin
    # Unset GWDG proxy baked into base %environment — unreachable outside GWDG.
    unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy

    apt-get update -qq
    apt-get install -y --no-install-recommends bash bzip2 ca-certificates curl libgomp1
    rm -rf /var/lib/apt/lists/*

    chmod +x /opt/agentic/entrypoint.sh

    export GOOSE_BIN_DIR=/usr/local/bin
    export CONFIGURE=false
    export INSTALL_OS=linux
    curl -fsSL "https://github.com/aaif-goose/goose/releases/download/stable/download_cli.sh" \
        | bash

    goose --version

    PYTHONPATH=/opt/agentic:${PYTHONPATH:-} python3.11 -c \
        "import goose_runtime.launcher; import goose_runtime.mcp_stdio_bridge"

    : "${BUILD_SHA:=unknown}"
    : "${BUILD_DATE:=unknown}"
    cat > /etc/chat-ai-image-info <<EOF
image=goose
task=4.1
version=0.2.0
git_sha=${BUILD_SHA}
build_date=${BUILD_DATE}
parent=mcp
mcp_port=8080
EOF

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PATH=/usr/local/bin:/usr/bin:/bin
    export PYTHONPATH=/opt/agentic:${PYTHONPATH:-}
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export MCP_SERVER_URL=${MCP_SERVER_URL:-http://localhost:8080}
    export MCP_SERVER_PORT=${MCP_SERVER_PORT:-8080}

%runscript
    #!/bin/sh
    if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
        cat <<EOF
chat-ai Goose image (Task 4.1): runs python3.11 -m goose_runtime.launcher
Pass any argv to bypass (e.g. goose --help, /bin/sh).

EOF
        exit 0
    fi
    if [ "$#" -gt 0 ]; then
        exec "$@"
    fi
    exec /opt/agentic/entrypoint.sh

%startscript
    exec /opt/agentic/entrypoint.sh

%labels
    org.chat-ai.image goose
    org.chat-ai.task 4.1
    org.chat-ai.version 0.2.0
    org.chat-ai.parent mcp
    org.chat-ai.mcp_port 8080
    org.chat-ai.framework goose-cli
    org.opencontainers.image.title chat-ai-goose-agent
    org.opencontainers.image.description Goose CLI + MCP + goose_runtime launcher

%help
    Task 4.1 — see README.md in agentic/containers/goose/
